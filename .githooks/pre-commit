#!/bin/sh
# Auto-sync barter-ai and barter-admin-api schema when swaphaven-api schema files are committed.
STAGED=$(git diff --cached --name-only -- "src/db/schema/")
if [ -n "$STAGED" ]; then
  node scripts/sync-barter-ai-schema.mjs < /dev/null
  node scripts/sync-admin-api-schema.mjs < /dev/null
  # Synced copies land in separate repos — user commits there separately.
fi
exit 0
